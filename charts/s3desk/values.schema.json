{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digests": {
          "type": "object",
          "properties": {
            "postgres": {
              "type": "string",
              "pattern": "^(|sha256:[0-9a-f]{64})$"
            },
            "sqlite": {
              "type": "string",
              "pattern": "^(|sha256:[0-9a-f]{64})$"
            }
          },
          "additionalProperties": true
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      },
      "additionalProperties": true
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": true
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": true
    },
    "resources": {
      "type": "object",
      "additionalProperties": true
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "size": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "additionalProperties": true
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pathType": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["path", "pathType"],
                  "additionalProperties": true
                }
              }
            },
            "required": ["host", "paths"],
            "additionalProperties": true
          }
        },
        "tls": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "istio": {
      "type": "object",
      "properties": {
        "virtualService": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "gateways": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "hosts": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Create a Kubernetes NetworkPolicy for the S3Desk pods."
        },
        "policyTypes": {
          "type": "array",
          "description": "NetworkPolicy policyTypes. Defaults to Ingress only so outbound provider/database traffic is not restricted unless explicitly enabled.",
          "items": {
            "type": "string",
            "enum": ["Ingress", "Egress"]
          }
        },
        "ingress": {
          "type": "object",
          "description": "Ingress NetworkPolicy controls for traffic into the S3Desk service pods.",
          "properties": {
            "allowSameNamespace": {
              "type": "boolean",
              "description": "Allow any pod in the release namespace to reach S3Desk. Disable this in shared production namespaces and use ingress.extra with controller/gateway selectors."
            },
            "extra": {
              "type": "array",
              "description": "Additional Kubernetes NetworkPolicyIngressRule entries. Use namespaceSelector plus podSelector for NGINX/Istio controller namespaces; `{}` is a temporary allow-all ingress escape hatch.",
              "items": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "array"
                  },
                  "ports": {
                    "type": "array"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": true
        },
        "egress": {
          "type": "object",
          "description": "Egress NetworkPolicy controls. These are only enforced when policyTypes includes Egress.",
          "properties": {
            "allowDns": {
              "type": "boolean",
              "description": "Allow TCP/UDP DNS on port 53 when Egress policy is enabled."
            },
            "extra": {
              "type": "array",
              "description": "Additional Kubernetes NetworkPolicyEgressRule entries for provider, database, proxy, or CIDR destinations. `{}` is a temporary allow-all egress escape hatch.",
              "items": {
                "type": "object",
                "properties": {
                  "to": {
                    "type": "array"
                  },
                  "ports": {
                    "type": "array"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "prometheusRule": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object"
            },
            "annotations": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string",
              "minLength": 1
            },
            "scrapeTimeout": {
              "type": "string"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "scheme": {
              "type": "string",
              "enum": ["http", "https"]
            },
            "honorLabels": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "podMonitor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string",
              "minLength": 1
            },
            "scrapeTimeout": {
              "type": "string"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "scheme": {
              "type": "string",
              "enum": ["http", "https"]
            },
            "honorLabels": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "server": {
      "type": "object",
      "properties": {
        "externalBaseURL": {
          "type": "string",
          "description": "Browser-facing base URL used for generated external links.",
          "pattern": "^$|^https?://.+"
        },
        "allowRemote": {
          "type": "boolean",
          "description": "Whether to allow non-local access. If true, a token is required for safe operation."
        },
        "apiToken": {
          "type": "string",
          "description": "API token used for authentication. Must not be the insecure placeholder value.",
          "not": {
            "enum": [
              "change-me",
              "changeme",
              "default",
              "token",
              "api-token",
              "s3desk",
              "s3desk-local",
              "replace-me",
              "replace-with-a-long-random-token",
              "replace-me-with-a-strong-token"
            ]
          }
        },
        "encryptionKey": {
          "type": "string",
          "description": "Backup authentication/encryption key. Browser-facing remote deployments require this or secrets.existingSecret."
        },
        "allowedHosts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "allowedLocalDirs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    },
    "db": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "enum": ["sqlite", "postgres"]
        },
        "databaseUrl": {
          "type": "string"
        },
        "startupTimeout": {
          "type": "string",
          "minLength": 1
        },
        "startupRetryInterval": {
          "type": "string",
          "minLength": 1
        },
        "maxOpenConns": {
          "type": "integer",
          "minimum": 0
        },
        "maxIdleConns": {
          "type": "integer",
          "minimum": 0
        },
        "connMaxLifetime": {
          "type": "string"
        },
        "connMaxIdleTime": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "jobs": {
      "type": "object",
      "properties": {
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "queueCapacity": {
          "type": "integer",
          "minimum": 1
        },
        "logMaxBytes": {
          "type": "integer",
          "minimum": 0
        },
        "logMaxLineBytes": {
          "type": "integer",
          "minimum": 0
        },
        "logEmitStdout": {
          "type": "boolean"
        },
        "retention": {
          "type": "string"
        },
        "logRetention": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "uploads": {
      "type": "object",
      "properties": {
        "ttl": {
          "type": "string",
          "minLength": 1
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maxConcurrentRequests": {
          "type": "integer",
          "minimum": 0
        },
        "directStream": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "backup": {
      "type": "object",
      "properties": {
        "restoreMaxBytes": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string",
          "description": "Name of an existing Secret that contains the API token / encryption key / database URL."
        },
        "autoGenerateApiToken": {
          "type": "boolean",
          "description": "Generate and persist an API token Secret automatically when remote access is enabled and no explicit token is provided."
        }
      },
      "additionalProperties": true
    },
    "rclone": {
      "type": "object",
      "properties": {
        "downloadMultiThreadStreams": {
          "type": "integer",
          "minimum": 0
        },
        "downloadMultiThreadCutoffMiB": {
          "type": "integer",
          "minimum": 0
        },
        "downloadBufferSizeMiB": {
          "type": "integer",
          "minimum": 0
        },
        "lowLevelRetries": {
          "type": "integer",
          "minimum": 0
        },
        "captureUnknownErrors": {
          "type": "boolean"
        },
        "retryAttempts": {
          "type": "integer",
          "minimum": 1,
          "description": "Max retry attempts for retryable rclone errors."
        },
        "retryBaseDelay": {
          "type": "string",
          "minLength": 1,
          "description": "Base delay for exponential retry backoff (Go duration format)."
        },
        "retryMaxDelay": {
          "type": "string",
          "minLength": 1,
          "description": "Maximum delay for retry backoff (Go duration format)."
        },
        "retryJitterRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Random jitter ratio for rclone retry delay. Range: 0..1."
        }
      },
      "additionalProperties": true
    },
    "extraEnvFrom": {
      "type": "array",
      "description": "Additional envFrom entries, typically SecretRef or ConfigMapRef objects."
    },
    "startupProbe": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["istio"],
        "properties": {
          "istio": {
            "type": "object",
            "required": ["virtualService"],
            "properties": {
              "virtualService": {
                "type": "object",
                "required": ["enabled"],
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "description": "When Istio VirtualService is enabled, require at least one host and one gateway.",
        "properties": {
          "istio": {
            "type": "object",
            "properties": {
              "virtualService": {
                "type": "object",
                "required": ["hosts", "gateways"],
                "properties": {
                  "hosts": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "gateways": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "server": {
            "type": "object",
            "properties": {
              "allowRemote": {
                "const": true
              }
            },
            "required": ["allowRemote"]
          }
        }
      },
      "then": {
        "description": "When remote access is enabled, require either a non-empty server.apiToken or secrets.existingSecret.",
        "anyOf": [
          {
            "properties": {
              "server": {
                "type": "object",
                "required": ["apiToken"],
                "properties": {
                  "apiToken": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "enum": [
                        "change-me",
                        "changeme",
                        "default",
                        "token",
                        "api-token",
                        "s3desk",
                        "s3desk-local",
                        "replace-me",
                        "replace-with-a-long-random-token",
                        "replace-me-with-a-strong-token"
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "secrets": {
                "type": "object",
                "required": ["autoGenerateApiToken"],
                "properties": {
                  "autoGenerateApiToken": {
                    "const": true
                  }
                }
              }
            }
          },
          {
            "properties": {
              "secrets": {
                "type": "object",
                "required": ["existingSecret"],
                "properties": {
                  "existingSecret": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "db": {
            "type": "object",
            "properties": {
              "backend": {
                "const": "postgres"
              }
            },
            "required": ["backend"]
          }
        }
      },
      "then": {
        "description": "When Postgres is enabled, require either db.databaseUrl or secrets.existingSecret.",
        "anyOf": [
          {
            "properties": {
              "db": {
                "type": "object",
                "required": ["databaseUrl"],
                "properties": {
                  "databaseUrl": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          {
            "properties": {
              "secrets": {
                "type": "object",
                "required": ["existingSecret"],
                "properties": {
                  "existingSecret": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        ]
      }
    }
  ],
  "additionalProperties": true
}
