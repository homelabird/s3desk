{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum by (provider, status) (rate(storage_list_page_requests_total[$__rate_interval]))", "legendFormat": "{{provider}} · {{status}}", "refId": "A" }
      ],
      "title": "Native list-page fetches",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "cps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum by (provider, operation) (rate(storage_rclone_list_entries_scanned_total[$__rate_interval]))", "legendFormat": "{{provider}} · {{operation}}", "refId": "A" }
      ],
      "title": "Fallback entries scanned",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "cps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum by (provider, operation, status) (rate(storage_operations_total[$__rate_interval]))", "legendFormat": "{{provider}} · {{operation}} · {{status}}", "refId": "A" }
      ],
      "title": "Logical storage operations",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "expr": "100 * ((sum by (provider) (rate(storage_list_page_requests_total{status=\"error\"}[$__rate_interval]))) or on (provider) (0 * sum by (provider) (rate(storage_list_page_requests_total[$__rate_interval])))) / clamp_min(sum by (provider) (rate(storage_list_page_requests_total[$__rate_interval])), 1e-9)",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "title": "Native page error rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, provider, operation) (rate(storage_operation_duration_ms_bucket{operation=~\"list_objects.*\"}[$__rate_interval])))",
          "legendFormat": "{{provider}} · {{operation}}",
          "refId": "A"
        }
      ],
      "title": "Object-list API p95 latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum by (provider) (rate(storage_api_retries_scheduled_total[$__rate_interval]))", "legendFormat": "{{provider}}", "refId": "A" }
      ],
      "title": "S3 SDK retry delays scheduled",
      "type": "timeseries"
    },
    {
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 32 },
      "id": 6,
      "options": {
        "mode": "markdown",
        "content": "These panels show API activity and fallback work, not currency. Provider pricing, retries, storage class, region, and egress affect the bill; compare with the provider billing console. Metrics intentionally omit profile, bucket, and object identifiers."
      },
      "title": "Reading this dashboard",
      "type": "text"
    }
  ],
